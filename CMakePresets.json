{
  "version": 3,
  "configurePresets": [
    {
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{GCC_ROOT}/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{GCC_ROOT}/bin/g++.exe",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static"
      },
      "environment": {
        "PATH": "$env{GCC_ROOT}/bin;$penv{PATH}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "hidden": true,
      "installDir": "${sourceDir}/out/install/${presetName}",
      "name": "windows-base"
    },
    {
      "name": "x64-debug",
      "displayName": "Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-release",
      "displayName": "Release",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
